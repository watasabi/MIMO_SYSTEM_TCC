t;br&gt;r&lt;sub&gt;i&lt;/sub&gt;(k) = Σ&lt;sub&gt;l&lt;/sub&gt; Σ&lt;sub&gt;d&lt;/sub&gt; γ&lt;sub&gt;ikld&lt;/sub&gt; T&lt;sub&gt;d&lt;/sub&gt;(ξ&lt;sub&gt;i&lt;/sub&gt;(t−l+1))&lt;br&gt;ξ&lt;sub&gt;i&lt;/sub&gt;: saída centrada, limitada a [−1, 1]&lt;br&gt;&lt;i&gt;polinômio explícito, iniciado em zero&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="395" y="455" width="345" height="190" as="geometry"/></mxCell><mxCell id="pai62" value="cascata L&lt;sup&gt;c&lt;/sup&gt;&lt;br&gt;κ ∫ (u&lt;sub&gt;4&lt;/sub&gt; − ŷ&lt;sub&gt;1&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="725" width="150" height="50" as="geometry"/></mxCell><mxCell id="pai63" value="saída direta&lt;br&gt;ŷ&lt;sub&gt;2&lt;/sub&gt;&lt;sup&gt;direto&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="205" y="725" width="150" height="50" as="geometry"/></mxCell><mxCell id="pai64" value="w&lt;sub&gt;k&lt;/sub&gt; L&lt;sup&gt;c&lt;/sup&gt; + (1−w&lt;sub&gt;k&lt;/sub&gt;) ŷ&lt;sub&gt;2&lt;/sub&gt;&lt;sup&gt;direto&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="105" y="820" width="175" height="45" as="geometry"/></mxCell><mxCell id="pai65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#333333;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pai62" target="pai64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pai66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#333333;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pai63" target="pai64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pai67" value="L&lt;sup&gt;c&lt;/sup&gt;(t+k) = L&lt;sup&gt;c&lt;/sup&gt;(t+k−1) + κ q̂ + δ&lt;br&gt;w&lt;sub&gt;k&lt;/sub&gt; ajustado na validação, por passo" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="345" height="90" as="geometry"/></mxCell><mxCell id="pai68" value="zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="400" y="730" width="105" height="40" as="geometry"/></mxCell><mxCell id="pai69" value="valor preso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="515" y="730" width="105" height="40" as="geometry"/></mxCell><mxCell id="pai70" value="saturação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="630" y="730" width="105" height="40" as="geometry"/></mxCell><mxCell id="pai71" value="em 30% das janelas, até 24 h,&lt;br&gt;com o valor real como alvo" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="395" y="775" width="345" height="50" as="geometry"/></mxCell><mxCell id="pai72" value="perda = L&lt;sub&gt;K&lt;/sub&gt; + λ&lt;sub&gt;c&lt;/sub&gt; MSE(L&lt;sup&gt;c&lt;/sup&gt;) + ρ P(E, C, D)&lt;br&gt;P: &lt;i&gt;sparse-group lasso&lt;/i&gt;, um grupo por aresta" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="395" y="840" width="345" height="130" as="geometry"/></mx