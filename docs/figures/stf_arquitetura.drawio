balanço de massa (u₄ → nível, y₁ → nível)" vertex="1"><mxGeometry height="250" width="145" x="1385" y="95" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff3e6;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" value="&lt;b&gt;Painel B · Aresta espectral j → i: função de transferência em 8 bandas&lt;/b&gt;" vertex="1"><mxGeometry height="260" width="680" x="860" y="380" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-124" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" value="s̃&lt;sub&gt;j&lt;/sub&gt;(t)&lt;br&gt;W+H amostras" vertex="1"><mxGeometry height="50" width="120" x="880" y="420" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-125" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" value="RFFT&lt;br&gt;n = 2(W+H)" vertex="1"><mxGeometry height="50" width="120" x="1025" y="420" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-126" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontSize=18;" value="×" vertex="1"><mxGeometry height="34" width="34" x="1172" y="428" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-127" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" value="Σ&lt;sub&gt;j&lt;/sub&gt; sobre&lt;br&gt;emissores" vertex="1"><mxGeometry height="50" width="120" x="1235" y="420" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-128" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" value="iRFFT → ŷ&lt;sub&gt;i&lt;/sub&gt;" vertex="1"><mxGeometry height="50" width="130" x="1385" y="420" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-129