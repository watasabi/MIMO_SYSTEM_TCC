<mxfile><diagram name="Arquitetura" id="arq"><mxGraphModel dx="2775" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;GOTAS&lt;/b&gt;: grafo de funções de transferência simulado como ARX, com resíduo não linear e nível pela física" vertex="1"><mxGeometry height="40" width="1640" x="40" y="10" as="geometry"/></mxCell><mxCell id="in_lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" value="Passado medido (168 h)&lt;br&gt;&lt;i&gt;u₁..u₄, y₁..y₃&lt;/i&gt;" vertex="1"><mxGeometry height="44" width="220" x="120" y="1330" as="geometry"/></mxCell><mxCell id="fut_lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" value="Entradas conhecidas (12 h)&lt;br&gt;&lt;i&gt;bombas (+ u₄ no full)&lt;/i&gt;" vertex="1"><mxGeometry height="44" width="220" x="380" y="1330" as="geometry"/></mxCell><mxCell id="seq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;Sequência por nó&lt;/b&gt; s&lt;sub&gt;j&lt;/sub&gt; ∈ ℝ&lt;sup&gt;W+H&lt;/sup&gt;, W = 168, H = 12&lt;br&gt;saídas futuras = 0 · nó extra: Σ(u₄ − y₁) das últimas horas" vertex="1"><mxGeometry height="70" width="420" x="140" y="1230" as="geometry"/></mxCell><mxCell id="norm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;Centralização&lt;/b&gt; s̃&lt;sub&gt;j&lt;/sub&gt; = s&lt;sub&gt;j&lt;/sub&gt; − μ&lt;sub&gt;j&lt;/sub&gt; (μ do passado; sem dividir por σ)" vertex="1"><mxGeometry height="50" width="420" x="140" y="1150" as="geometry"/></mxCell><mxCell id="loop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#eaf7f6;strokeColor=#4f9e9a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" value="&lt;b&gt;× 12 passos: simulação recursiva (painel C)&lt;/b&gt;" vertex="1"><mxGeometry height="500" width="480" x="110" y="620" as="geometry"/></mxCell><mxCell id="rfft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;RFFT&lt;/b&gt; com zero-padding 2(W+H) → S&lt;sub&gt;j&lt;/sub&gt;(f)" vertex="1"><mxGeometry height="46" width="380" x="160" y="1040" as="geometry"/></mxCell><mxCell id="filt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;Grafo de filtros&lt;/b&gt; (painéis A e B)&lt;br&gt;Y&lt;sub&gt;i&lt;/sub&gt;(f) = Σ&lt;sub&gt;j&lt;/sub&gt; H&lt;sub&gt;ij&lt;/sub&gt;(f) · S&lt;sub&gt;j&lt;/sub&gt;(f)" vertex="1"><mxGeometry height="70" width="380" x="160" y="940" as="geometry"/></mxCell><mxCell id="irfft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;iRFFT&lt;/b&gt;, posição W+k → ŷ&lt;sub&gt;i&lt;/sub&gt;(t+k) + b&lt;sub&gt;i&lt;/sub&gt;" vertex="1"><mxGeometry height="46" width="380" x="160" y="860" as="geometry"/></mxCell><mxCell id="write" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;Escreve ŷ(t+k) na sequência&lt;/b&gt;&lt;br&gt;a saída futura k passa a ser a própria previsão" vertex="1"><mxGeometry height="62" width="380" x="160" y="770" as="geometry"/></mxCell><mxCell id="loop_note" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" value="&lt;i&gt;equação de 1 passo, iterada:&lt;/i&gt;&lt;br&gt;ŷ&lt;sub&gt;i&lt;/sub&gt;(t) = Σ&lt;sub&gt;j&lt;/sub&gt; Σ&lt;sub&gt;τ&lt;/sub&gt; h&lt;sub&gt;ij&lt;/sub&gt;(τ) s̃&lt;sub&gt;j&lt;/sub&gt;(t−τ) + b&lt;sub&gt;i&lt;/sub&gt;" vertex="1"><mxGeometry height="80" width="380" x="160" y="670" as="geometry"/></mxCell><mxCell id="resid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;Resíduo não linear&lt;/b&gt; (painel D)&lt;br&gt;passado de y&lt;sub&gt;i&lt;/sub&gt; → Linear(168→16) → tanh → Linear(16→12)&lt;br&gt;iniciado em 0" vertex="1"><mxGeometry height="120" width="210" x="630" y="930" as="geometry"/></mxCell><mxCell id="plus" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontSize=18;" value="+" vertex="1"><mxGeometry height="34" width="34" x="333" y="560" as="geometry"/></mxCell><mxCell id="plus_lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" value="+ μ&lt;sub&gt;i&lt;/sub&gt;" vertex="1"><mxGeometry height="30" width="70" x="372" y="545" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-3" edge="1" parent="1" source="direct" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;curved=0;" target="casc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-5" connectable="0" parent="fiqWIdZ9mZWPgGTb98P2-3" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;defaultLabelBackgroundColor=page;" value="&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;ŷ₁&lt;/span&gt;" vertex="1"><mxGeometry relative="1" x="0.0777" y="-2" as="geometry"><mxPoint x="-2" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="direct" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;Saídas diretas&lt;/b&gt; ŷ₁ vazão · ŷ₃ pressão · ŷ₂&lt;sup