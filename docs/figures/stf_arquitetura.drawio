<mxfile><diagram name="Arquitetura" id="arq"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;SpectralTFNet — modelo final&lt;/b&gt;: grafo de funções de transferência simulado como ARX, com ensemble de H̄, cascata física e nível combinado" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1640" height="40" as="geometry"/></mxCell><mxCell id="in_lbl" value="Passado medido (168 h)&lt;br&gt;&lt;i&gt;u₁..u₄, y₁..y₃&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1370" width="220" height="40" as="geometry"/></mxCell><mxCell id="fut_lbl" value="Entradas conhecidas (12 h)&lt;br&gt;&lt;i&gt;bombas u₁..u₃ (+ u₄ no full)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1370" width="220" height="40" as="geometry"/></mxCell><mxCell id="seq" value="&lt;b&gt;Sequência por nó&lt;/b&gt;&amp;nbsp; s&lt;sub&gt;j&lt;/sub&gt; ∈ ℝ&lt;sup&gt;W+H&lt;/sup&gt;, W = 168, H = 12&lt;br&gt;&lt;font style='font-size:11px'&gt;saídas futuras = 0 &amp;nbsp;·&amp;nbsp; nó extra: balanço de massa Σ(u₄ − y₁)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="1270" width="420" height="70" as="geometry"/></mxCell><mxCell id="norm" value="&lt;b&gt;Centralização&lt;/b&gt;&amp;nbsp; s̃&lt;sub&gt;j&lt;/sub&gt; = s&lt;sub&gt;j&lt;/sub&gt; − μ&lt;sub&gt;j&lt;/sub&gt;&amp;nbsp; (μ só do passado; sem dividir por σ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="1190" width="420" height="50" as="geometry"/></mxCell><mxCell id="loop" value="× 12 passos — simulação recursiva (painel B)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="690" width="480" height="470" as="geometry"/></mxCell><mxCell id="rfft" value="&lt;b&gt;RFFT&lt;/b&gt; com zero-padding 2(W+H)&amp;nbsp; → &amp;nbsp;S&lt;sub&gt;j&lt;/sub&gt;(f)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="1080" width="380" height="46" as="geometry"/></mxCell><mxCell id="filt" value="&lt;b&gt;Grafo de filtros&lt;/b&gt; (painel A)&lt;br&gt;Y&lt;sub&gt;i&lt;/sub&gt;(f) = Σ&lt;sub&gt;j&lt;/sub&gt; H̄&lt;sub&gt;ij&lt;/sub&gt;(f) · S&lt;sub&gt;j&lt;/sub&gt;(f)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="990" width="380" height="62" as="geometry"/></mxCell><mxCell id="irfft" value="&lt;b&gt;iRFFT&lt;/b&gt; e leitura da posição W+k&amp;nbsp; → &amp;nbsp;ŷ&lt;sub&gt;i&lt;/sub&gt;(t+k) + b&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="912" width="380" height="46" as="geometry"/></mxCell><mxCell id="write" value="&lt;b&gt;Escreve ŷ(t+k) na sequência&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;entradas conhecidas ficam; saída futura k passa a ser a previsão&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="820" width="380" height="62" as="geometry"/></mxCell><mxCell id="loop_note" value="&lt;i&gt;A equação de 1 passo é iterada:&lt;br&gt;ŷ&lt;sub&gt;i&lt;/sub&gt;(t) = Σ&lt;sub&gt;j&lt;/sub&gt; Σ&lt;sub&gt;τ&lt;/sub&gt; h̄&lt;sub&gt;ij&lt;/sub&gt;(τ) s̃&lt;sub&gt;j&lt;/sub&gt;(t−τ) + b&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="730" width="380" height="70" as="geometry"/></mxCell><mxCell id="ens" value="&lt;b&gt;Ensemble de H̄&lt;/b&gt; (painel C)&lt;br&gt;5 treinos (seeds 42–46)&lt;br&gt;H̄&lt;sub&gt;ij&lt;/sub&gt; = ⅕ Σ&lt;sub&gt;s&lt;/sub&gt; H&lt;sup&gt;(s)&lt;/sup&gt;&lt;sub&gt;ij&lt;/sub&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;continua uma única matriz de funções de transferência&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fad9d5;strokeColor=#ae4132;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-160" y="990" width="230" height="120" as="geometry"/></mxCell><mxCell id="resid" value="&lt;b&gt;Resíduo não linear&lt;/b&gt;&lt;br&gt;r̄&lt;sub&gt;i&lt;/sub&gt; = média de 5 MLPs&lt;br&gt;&lt;font style='font-size:11px'&gt;passado de y&lt;sub&gt;i&lt;/sub&gt; → Linear(168→16) → tanh → Linear(16→12), iniciado em 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="1000" width="200" height="110" as="geometry"/></mxCell><mxCell id="plus" value="+" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=18;" vertex="1" parent="1"><mxGeometry x="333.0" y="630" width="34" height="34" as="geometry"/></mxCell><mxCell id="plus_lbl" value="+ μ&lt;sub&gt;i&lt;/sub&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375.0" y="628" width="120" height="40" as="geometry"/></mxCell><mxCell id="direct" value="&lt;b&gt;Saídas diretas&lt;/b&gt;&amp;nbsp; ŷ₁ vazão &amp;nbsp;·&amp;nbsp; ŷ₃ pressão &amp;nbsp;·&amp;nbsp; ŷ₂&lt;sup&gt;direto&lt;/sup&gt; nível" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="540" width="420" height="56" as="geometry"/></mxCell><mxCell id="casc" value="&lt;b&gt;Cascata física&lt;/b&gt; (painel D)&lt;br&gt;balanço de massa com&lt;br&gt;q̂ = u₄ − ŷ₁ &amp;nbsp;→&amp;nbsp; nível&lt;sup&gt;cascata&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="440" width="260" height="96" as="geometry"/></mxCell><mxCell id="blend" value="&lt;b&gt;Nível combinado&lt;/b&gt; (painel D)&lt;br&gt;ŷ₂(t+h) = w&lt;sub&gt;h&lt;/sub&gt;·cascata + (1 − w&lt;sub&gt;h&lt;/sub&gt;)·direto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="420" width="420" height="70" as="geometry"/></mxCell><mxCell id="conf" value="&lt;b&gt;Intervalos conformal&lt;/b&gt; (painel E)&lt;br&gt;ŷ ± q&lt;sub&gt;h,i&lt;/sub&gt;&amp;nbsp; por passo e saída" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="320" width="420" height="64" as="geometry"/></mxCell><mxCell id="out_lbl" value="&lt;b&gt;Previsão de 12 h&lt;/b&gt;&lt;br&gt;vazão, nível e pressão, com intervalo de 80% / 90%" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="140" y="220" width="420" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="seq" target="norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="norm" target="rfft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="rfft" target="filt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="filt" target="irfft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="irfft" target="write"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_loop" value="próximo passo k+1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="write" target="rfft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="851"/><mxPoint x="130" y="1103"/></Array></mxGeometry></mxCell><mxCell id="e_ens" value="H̄" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=1;exitY=0.33;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ens" target="filt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_res_in" value="passado de y&lt;sub&gt;i&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="norm" target="resid"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="1215"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="loop" target="plus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_res_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="resid" target="plus"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="647"/></Array></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="plus" target="direct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="ŷ₁" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="direct" target="casc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="568"/></Array></mxGeometry></mxCell><mxCell id="e9" value="ŷ₂ direto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="direct" target="blend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="cascata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="casc" target="blend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="blend" target="conf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="conf" target="out_lbl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_fut" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fut_lbl" target="seq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="in_lbl" target="seq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_u4" value="u₄ futura (full) ou&lt;br&gt;do dia anterior (pumps)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fut_lbl" target="casc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="1390"/></Array></mxGeometry></mxCell><mxCell id="pA" value="A · Aresta espectral j → i (função de transferência por bandas)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="680" height="330" as="geometry"/></mxCell><mxCell id="a_sj" value="s̃&lt;sub&gt;j&lt;/sub&gt;(t)&lt;br&gt;&lt;font style='font-size:11px'&gt;W+H amostras&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="130" height="50" as="geometry"/></mxCell><mxCell id="a_rfft" value="RFFT&lt;br&gt;&lt;font style='font-size:11px'&gt;n = 2(W+H)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="130" height="50" as="geometry"/></mxCell><mxCell id="a_mul" value="×" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1345" y="128" width="34" height="34" as="geometry"/></mxCell><mxCell id="a_sum" value="Σ&lt;sub&gt;j&lt;/sub&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;sobre emissores&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="120" width="110" height="50" as="geometry"/></mxCell><mxCell id="a_irfft" value="iRFFT → ŷ&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="120" width="110" height="50" as="geometry"/></mxCell><mxCell id="a_bands" value="&lt;b&gt;8 bandas complexas&lt;/b&gt; c&lt;sub&gt;ij,m&lt;/sub&gt; ∈ ℂ&lt;br&gt;centros log-espaçados (m = 0 em DC)&lt;br&gt;&lt;font style='font-size:11px'&gt;8 × 2 reais por aresta → 387 parâmetros lineares&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="215" width="300" height="76" as="geometry"/></mxCell><mxCell id="a_interp" value="&lt;b&gt;Interpolação&lt;/b&gt;&lt;br&gt;H&lt;sub&gt;ij&lt;/sub&gt;(f) = Σ&lt;sub&gt;m&lt;/sub&gt; Λ(f, m) · c&lt;sub&gt;ij,m&lt;/sub&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Λ linear entre centros vizinhos (resposta suave)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="215" width="310" height="76" as="geometry"/></mxCell><mxCell id="a_eq" value="&lt;b&gt;Equação lida da aresta:&lt;/b&gt; h&lt;sub&gt;ij&lt;/sub&gt;(τ) = iRFFT(H&lt;sub&gt;ij&lt;/sub&gt;)(τ)&amp;nbsp;&amp;nbsp;⇒&amp;nbsp;&amp;nbsp;ŷ&lt;sub&gt;i&lt;/sub&gt;(t) = Σ&lt;sub&gt;j&lt;/sub&gt; Σ&lt;sub&gt;τ&lt;/sub&gt; h&lt;sub&gt;ij&lt;/sub&gt;(τ)·s̃&lt;sub&gt;j&lt;/sub&gt;(t−τ) + b&lt;sub&gt;i&lt;/sub&gt;&lt;br&gt;&lt;i&gt;matriz de funções de transferência MIMO (família ARX); |H&lt;sub&gt;ij&lt;/sub&gt;| por banda = grafo de acoplamento por frequência&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="640" height="90" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="a_sj" target="a_rfft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="a_rfft" target="a_mul"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="a_mul" target="a_sum"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="a_sum" target="a_irfft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="a_bands" target="a_interp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="H&lt;sub&gt;ij&lt;/sub&gt;(f)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_interp" target="a_mul"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pB" value="B · Simulação recursiva de 1 passo (por que não um filtro direto)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="680" height="250" as="geometry"/></mxCell><mxCell id="b_seq" value="sequência no passo k:&lt;br&gt;[ passado 168 h | ŷ(t+1..t+k−1) | 0 … ]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="470" width="250" height="66" as="geometry"/></mxCell><mxCell id="b_step" value="filtro de 1 passo&lt;br&gt;na posição W+k" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="470" width="170" height="66" as="geometry"/></mxCell><mxCell id="b_out" value="ŷ(t+k)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="470" width="160" height="66" as="geometry"/></mxCell><mxCell id="b_note" value="• As auto-arestas H&lt;sub&gt;ii&lt;/sub&gt; são os polinômios autorregressivos (os polos); as arestas das entradas, a parte exógena.&lt;br&gt;• Entradas conhecidas entram passo a passo; saídas futuras começam em 0 e são preenchidas com a própria previsão.&lt;br&gt;• Um filtro aplicado de uma vez não prevê vários passos do próprio passado (R² negativo); iterado, chega a 0,79." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="1020" y="550" width="640" height="110" as="geometry"/></mxCell><mxCell id="b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="b_seq" target="b_step"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="b_step" target="b_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b3" value="k ← k+1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_out" target="b_seq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="456"/><mxPoint x="1145" y="456"/></Array></mxGeometry></mxCell><mxCell id="pC" value="C · Ensemble que continua sendo uma equação" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="690" width="680" height="170" as="geometry"/></mxCell><mxCell id="c_seeds" value="5 treinos&lt;br&gt;H&lt;sup&gt;(42)&lt;/sup&gt; … H&lt;sup&gt;(46)&lt;/sup&gt;&lt;br&gt;r&lt;sup&gt;(42)&lt;/sup&gt; … r&lt;sup&gt;(46)&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fad9d5;strokeColor=#ae4132;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="735" width="200" height="100" as="geometry"/></mxCell><mxCell id="c_avg" value="H̄ = média das respostas&lt;br&gt;em frequência&lt;br&gt;r̄ = média dos resíduos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fad9d5;strokeColor=#ae4132;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="735" width="200" height="100" as="geometry"/></mxCell><mxCell id="c_note" value="rende o mesmo que a média das previsões (Δ máx. 0,002) e mantém &lt;b&gt;uma&lt;/b&gt; matriz H̄&lt;sub&gt;ij&lt;/sub&gt;(f)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1470" y="735" width="195" height="100" as="geometry"/></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="c_seeds" target="c_avg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pD" value="D · Cascata física do nível e combinação" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="880" width="680" height="250" as="geometry"/></mxCell><mxCell id="d_casc" value="&lt;b&gt;Balanço de massa&lt;/b&gt; (integrador)&lt;br&gt;N(t+k) = N(t+k−1) + a·½(q̂&lt;sub&gt;k&lt;/sub&gt; + q̂&lt;sub&gt;k−1&lt;/sub&gt;) + b&lt;br&gt;q̂ = u₄ − ŷ₁,&amp;nbsp; a = 0,00277 m/(l/s)&lt;br&gt;&lt;font style='font-size:11px'&gt;também como loss: o gradiente do erro do nível chega à vazão&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="925" width="310" height="110" as="geometry"/></mxCell><mxCell id="d_blend" value="&lt;b&gt;Combinação por passo&lt;/b&gt;&lt;br&gt;ŷ₂(t+h) = w&lt;sub&gt;h&lt;/sub&gt;·N(t+h) + (1−w&lt;sub&gt;h&lt;/sub&gt;)·ŷ₂&lt;sup&gt;direto&lt;/sup&gt;&lt;br&gt;w&lt;sub&gt;h&lt;/sub&gt; por mínimos quadrados na validação&lt;br&gt;&lt;font style='font-size:11px'&gt;full: 0,93 → 0,71 &amp;nbsp;·&amp;nbsp; pumps: 0,87 → 0,14&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="925" width="310" height="110" as="geometry"/></mxCell><mxCell id="d_note" value="&lt;i&gt;A cascata parte do nível medido e vale quase tudo perto da origem; com o horizonte, o erro integrado da vazão cresce e a saída direta ganha peso.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="1045" width="640" height="70" as="geometry"/></mxCell><mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="d_casc" target="d_blend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pE" value="E · Treino e incerteza" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="1150" width="680" height="260" as="geometry"/></mxCell><mxCell id="e_loss" value="&lt;b&gt;Loss&lt;/b&gt;&lt;br&gt;Σ&lt;sub&gt;i&lt;/sub&gt; [ MSE&lt;sub&gt;i&lt;/sub&gt; / 2σ&lt;sub&gt;i&lt;/sub&gt;² + log σ&lt;sub&gt;i&lt;/sub&gt; ]&amp;nbsp; (pesos aprendidos)&lt;br&gt;+ λ&lt;sub&gt;c&lt;/sub&gt; · MSE(nível&lt;sup&gt;cascata&lt;/sup&gt;)&lt;br&gt;+ ρ · Σ&lt;sub&gt;(i,j)&lt;/sub&gt; ‖c&lt;sub&gt;ij,·&lt;/sub&gt;‖ &amp;nbsp;(sparse-group lasso)&lt;br&gt;&lt;font style='font-size:11px'&gt;lasso zera arestas inteiras ou bandas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="1195" width="310" height="140" as="geometry"/></mxCell><mxCell id="e_conf" value="&lt;b&gt;Intervalos conformal&lt;/b&gt;&lt;br&gt;q&lt;sub&gt;h,i&lt;/sub&gt; = quantil de |erro| na validação&lt;br&gt;intervalo: ŷ ± q&lt;sub&gt;h,i&lt;/sub&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;cobertura no teste: 0,78–0,84 (80%) · 0,87–0,94 (90%)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="1195" width="310" height="140" as="geometry"/></mxCell><mxCell id="e_note" value="&lt;i&gt;Laplace sobre H do modelo linear: balanço de massa +0,00345 [0,00306; 0,00384] e −0,00230 [−0,00327; −0,00133] m/(l/s)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="1345" width="640" height="55" as="geometry"/></mxCell><mxCell id="z1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;" edge="1" parent="1" source="filt" target="pA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="1021"/><mxPoint x="780" y="235"/></Array></mxGeometry></mxCell><mxCell id="z2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;" edge="1" parent="1" source="loop" target="pB"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="700"/><mxPoint x="800" y="545"/></Array></mxGeometry></mxCell><mxCell id="z3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;" edge="1" parent="1" source="ens" target="pC"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="980"/><mxPoint x="100" y="650"/><mxPoint x="820" y="650"/><mxPoint x="820" y="775"/></Array></mxGeometry></mxCell><mxCell id="z4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;" edge="1" parent="1" source="casc" target="pD"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="488"/><mxPoint x="900" y="1005"/></Array></mxGeometry></mxCell><mxCell id="z5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;" edge="1" parent="1" source="conf" target="pE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="352"/><mxPoint x="940" y="1280"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>