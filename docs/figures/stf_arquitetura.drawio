"rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;Balanço de massa&lt;/b&gt; (integrador)&lt;br&gt;N(t+k) = N(t+k−1) + a·½(q̂&lt;sub&gt;k&lt;/sub&gt; + q̂&lt;sub&gt;k−1&lt;/sub&gt;) + b&lt;br&gt;q̂ = u₄ − ŷ₁, a = 0,00277 m/(l/s)&lt;br&gt;parte do nível medido" vertex="1"><mxGeometry height="110" width="310" x="880" y="1120" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-159" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;Combinação por passo&lt;/b&gt;&lt;br&gt;ŷ₂(t+h) = w&lt;sub&gt;h&lt;/sub&gt;·N(t+h) + (1−w&lt;sub&gt;h&lt;/sub&gt;)·ŷ₂&lt;sup&gt;direto&lt;/sup&gt;&lt;br&gt;12 pesos por mínimos quadrados na validação&lt;br&gt;full: 0,93 → 0,70 · pumps: 0,87 → 0,14" vertex="1"><mxGeometry height="110" width="310" x="1210" y="1120" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-160" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;" value="&lt;i&gt;perto da origem a cascata integrou pouco erro e domina; com o horizonte, o erro da vazão se acumula e a saída direta ganha peso&lt;/i&gt;" vertex="1"><mxGeometry height="50" width="640" x="880" y="1240" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-161" edge="1" parent="1" source="fiqWIdZ9mZWPgGTb98P2-158" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" target="fiqWIdZ9mZWPgGTb98P2-159" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-162" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f6eef9;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" value="&lt;b&gt;Painel F · Função de perda (treino)&lt;/b&gt;" vertex="1"><mxGeometry height="150" width="680" x="860" y="1320" as="geometry"/></mxCell><mxCell id="fiqWIdZ9mZWPgGTb98P2-163" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="ℒ = Σ&lt;sub&gt;i&lt;/sub&gt; [ MSE&lt;sub&gt;i&lt;/sub&gt; / 2σ&lt;sub&gt;i&lt;/sub&gt;² + log σ&lt;sub&gt;i&lt;/sub&gt; ] + λ&lt;sub&gt;c&lt;/sub&gt;·MSE(nível&lt;sup&gt;cascata&lt;/sup&gt;) + ρ·[ α Σ |c&lt;sub&gt;ij,m&lt;/sub&gt;| + (1−α) Σ ‖c&lt;sub&gt;ij,·&lt;/sub&gt;‖ ]&lt;br&gt;&lt;br&gt;pesos por saída aprendidos (3 parâmetros) · cascata na perda: o erro do nível chega à vazão · lasso por grupo: zera bandas e arestas inteiras (ρ = 10⁻³)" vertex="1"><mxGeometry height="105" width="640" x="880" y="1355" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>