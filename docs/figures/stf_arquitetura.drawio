<mxfile><diagram name="Arquitetura" id="arq"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1750" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;SpectralTFNet&lt;/b&gt;: grafo de funções de transferência simulado como ARX, com resíduo não linear e nível pela física" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1640" height="40" as="geometry"/></mxCell><mxCell id="in_lbl" value="Passado medido (168 h)&lt;br&gt;&lt;i&gt;u₁..u₄, y₁..y₃&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1330" width="220" height="44" as="geometry"/></mxCell><mxCell id="fut_lbl" value="Entradas conhecidas (12 h)&lt;br&gt;&lt;i&gt;bombas (+ u₄ no full)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1330" width="220" height="44" as="geometry"/></mxCell><mxCell id="seq" value="&lt;b&gt;Sequência por nó&lt;/b&gt; s&lt;sub&gt;j&lt;/sub&gt; ∈ ℝ&lt;sup&gt;W+H&lt;/sup&gt;, W = 168, H = 12&lt;br&gt;saídas futuras = 0 · nó extra: Σ(u₄ − y₁) das últimas horas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="1230" width="420" height="70" as="geometry"/></mxCell><mxCell id="norm" value="&lt;b&gt;Centralização&lt;/b&gt; s̃&lt;sub&gt;j&lt;/sub&gt; = s&lt;sub&gt;j&lt;/sub&gt; − μ&lt;sub&gt;j&lt;/sub&gt; (μ do passado; sem dividir por σ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="1150" width="420" height="50" as="geometry"/></mxCell><mxCell id="loop" value="&lt;b&gt;× 12 passos: simulação recursiva (painel C)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="620" width="480" height="500" as="geometry"/></mxCell><mxCell id="rfft" value="&lt;b&gt;RFFT&lt;/b&gt; com zero-padding 2(W+H) → S&lt;sub&gt;j&lt;/sub&gt;(f)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="1040" width="380" height="46" as="geometry"/></mxCell><mxCell id="filt" value="&lt;b&gt;Grafo de filtros&lt;/b&gt; (painéis A e B)&lt;br&gt;Y&lt;sub&gt;i&lt;/sub&gt;(f) = Σ&lt;sub&gt;j&lt;/sub&gt; H&lt;sub&gt;ij&lt;/sub&gt;(f) · S&lt;sub&gt;j&lt;/sub&gt;(f)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="940" width="380" height="70" as="geometry"/></mxCell><mxCell id="irfft" value="&lt;b&gt;iRFFT&lt;/b&gt;, posição W+k → ŷ&lt;sub&gt;i&lt;/sub&gt;(t+k) + b&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="860" width="380" height="46" as="geometry"/></mxCell><mxCell id="write" value="&lt;b&gt;Escreve ŷ(t+k) na sequência&lt;/b&gt;&lt;br&gt;a saída futura k passa a ser a própria previsão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="770" width="380" height="62" as="geometry"/></mxCell><mxCell id="loop_note" value="&lt;i&gt;equação de 1 passo, iterada:&lt;/i&gt;&lt;br&gt;ŷ&lt;sub&gt;i&lt;/sub&gt;(t) = Σ&lt;sub&gt;j&lt;/sub&gt; Σ&lt;sub&gt;τ&lt;/sub&gt; h&lt;sub&gt;ij&lt;/sub&gt;(τ) s̃&lt;sub&gt;j&lt;/sub&gt;(t−τ) + b&lt;sub&gt;i&lt;/sub&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="670" width="380" height="80" as="geometry"/></mxCell><mxCell id="resid" value="&lt;b&gt;Resíduo não linear&lt;/b&gt; (painel D)&lt;br&gt;passado de y&lt;sub&gt;i&lt;/sub&gt; → Linear(168→16) → tanh → Linear(16→12)&lt;br&gt;iniciado em 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="930" width="210" height="120" as="geometry"/></mxCell><mxCell id="plus" value="+" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontSize=18;" vertex="1" parent="1"><mxGeometry x="333.0" y="560" width="34" height="34" as="geometry"/></mxCell><mxCell id="plus_lbl" value="+ μ&lt;sub&gt;i&lt;/sub&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="372.0" y="545" width="70" height="30" as="geometry"/></mxCell><mxCell id="direct" value="&lt;b&gt;Saídas diretas&lt;/b&gt; ŷ₁ vazão · ŷ₃ pressão · ŷ₂&lt;sup&gt;direto&lt;/sup&gt; nível" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="420" height="56" as="geometry"/></mxCell><mxCell id="casc" value="&lt;b&gt;Cascata física&lt;/b&gt; (painel E)&lt;br&gt;balanço de massa com&lt;br&gt;q̂ = u₄ − ŷ₁ → nível&lt;sup&gt;cascata&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="370" width="250" height="96" as="geometry"/></mxCell><mxCell id="blend" value="&lt;b&gt;Nível combinado&lt;/b&gt; (painel E)&lt;br&gt;ŷ₂(t+h) = w&lt;sub&gt;h&lt;/sub&gt;·cascata + (1 − w&lt;sub&gt;h&lt;/sub&gt;)·direto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="350" width="420" height="70" as="geometry"/></mxCell><mxCell id="out_lbl" value="&lt;b&gt;Previsão de 12 h&lt;/b&gt;&lt;br&gt;vazão, nível e pressão" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="140" y="240" width="420" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="seq" target="norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="norm" target="rfft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="rfft" target="filt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="filt" target="irfft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="irfft" target="write"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eloop" value="próximo passo k+1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="write" target="rfft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="801"/><mxPoint x="130" y="1063"/></Array></mxGeometry></mxCell><mxCell id="eres_in" value="passado de y&lt;sub&gt;i&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="norm" target="resid"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="1175"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="loop" target="plus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eres_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="resid" target="plus"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="577"/></Array></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="plus" target="direct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="ŷ₁" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="direct" target="casc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="498"/></Array></mxGeometry></mxCell><mxCell id="e9" value="ŷ₂ direto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="direct" target="blend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="cascata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="casc" target="blend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="blend" target="out_lbl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ein" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="in_lbl" target="seq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efut" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fut_lbl" target="seq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eu4" value="u₄ futura (full) ou&lt;br&gt;do dia anterior (pumps)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="fut_lbl" target="casc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="1352"/></Array></mxGeometry></mxCell><mxCell id="pA" value="&lt;b&gt;A · O grafo: 8 nós emissores → 3 saídas, cada aresta é H&lt;sub&gt;ij&lt;/sub&gt;(f)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="680" height="300" as="geometry"/></mxCell><mxCell id="n_u1" value="u₁ bomba 1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="95" width="150" height="25" as="geometry"/></mxCell><mxCell id="n_u2" value="u₂ bomba 2" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="126" width="150" height="25" as="geometry"/></mxCell><mxCell id="n_u3" value="u₃ bomba 3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="157" width="150" height="25" as="geometry"/></mxCell><mxCell id="n_u4" value="u₄ vazão entrada" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="188" width="150" height="25" as="geometry"/></mxCell><mxCell id="n_y1" value="y₁ vazão dist." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="219" width="150" height="25" as="geometry"/></mxCell><mxCell id="n_y2" value="y₂ nível" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="250" width="150" height="25" as="geometry"/></mxCell><mxCell id="n_y3" value="y₃ pressão" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="281" width="150" height="25" as="geometry"/></mxCell><mxCell id="n_bm" value="Σ(u₄ − y₁)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="312" width="150" height="25" as="geometry"/></mxCell><mxCell id="n_t1" value="ŷ₁(t+k)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="125" width="110" height="34" as="geometry"/></mxCell><mxCell id="n_t2" value="ŷ₂(t+k)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="195" width="110" height="34" as="geometry"/></mxCell><mxCell id="n_t3" value="ŷ₃(t+k)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="265" width="110" height="34" as="geometry"/></mxCell><mxCell id="g_u1_t1" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u1" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u1_t2" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u1" target="n_t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u1_t3" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u1" target="n_t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u2_t1" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u2" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u2_t2" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u2" target="n_t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u2_t3" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u2" target="n_t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u3_t1" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u3" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u3_t2" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u3" target="n_t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u3_t3" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u3" target="n_t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u4_t1" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u4" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u4_t2" style="html=1;endArrow=classic;endSize=4;strokeColor=#82b366;strokeWidth=2.5;" edge="1" parent="1" source="n_u4" target="n_t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_u4_t3" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_u4" target="n_t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y1_t1" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_y1" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y1_t2" style="html=1;endArrow=classic;endSize=4;strokeColor=#82b366;strokeWidth=2.5;" edge="1" parent="1" source="n_y1" target="n_t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y1_t3" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_y1" target="n_t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y2_t1" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_y2" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y2_t2" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_y2" target="n_t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y2_t3" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_y2" target="n_t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y3_t1" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_y3" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y3_t2" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_y3" target="n_t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_y3_t3" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_y3" target="n_t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_bm_t1" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_bm" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_bm_t2" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_bm" target="n_t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_bm_t3" style="html=1;endArrow=classic;endSize=4;strokeColor=#c8c8c8;strokeWidth=0.8;" edge="1" parent="1" source="n_bm" target="n_t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_note" value="&lt;b&gt;nó&lt;/b&gt; = série (sequência s&lt;sub&gt;j&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;aresta j → i&lt;/b&gt; = filtro H&lt;sub&gt;ij&lt;/sub&gt;(f)&lt;br&gt;&lt;br&gt;&lt;b&gt;mensagem&lt;/b&gt; = s&lt;sub&gt;j&lt;/sub&gt; filtrado&lt;br&gt;&lt;br&gt;&lt;b&gt;agregação&lt;/b&gt; = Σ&lt;sub&gt;j&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#82b366'&gt;&lt;b&gt;verde&lt;/b&gt;&lt;/font&gt;: o balanço de massa (u₄ → nível, y₁ → nível)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1525" y="95" width="145" height="250" as="geometry"/></mxCell><mxCell id="pB" value="&lt;b&gt;B · Aresta espectral j → i: função de transferência em 8 bandas&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="380" width="680" height="260" as="geometry"/></mxCell><mxCell id="b_sj" value="s̃&lt;sub&gt;j&lt;/sub&gt;(t)&lt;br&gt;W+H amostras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="120" height="50" as="geometry"/></mxCell><mxCell id="b_fft" value="RFFT&lt;br&gt;n = 2(W+H)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="420" width="120" height="50" as="geometry"/></mxCell><mxCell id="b_mul" value="×" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1312" y="428" width="34" height="34" as="geometry"/></mxCell><mxCell id="b_sum" value="Σ&lt;sub&gt;j&lt;/sub&gt; sobre&lt;br&gt;emissores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1375" y="420" width="120" height="50" as="geometry"/></mxCell><mxCell id="b_ifft" value="iRFFT → ŷ&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1525" y="420" width="130" height="50" as="geometry"/></mxCell><mxCell id="b_bands" value="&lt;b&gt;8 coeficientes complexos&lt;/b&gt; c&lt;sub&gt;ij,m&lt;/sub&gt;&lt;br&gt;centros log-espaçados (m = 0 em DC)&lt;br&gt;3 × 8 × 8 × 2 + 3 = 387 parâmetros" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="505" width="300" height="70" as="geometry"/></mxCell><mxCell id="b_interp" value="&lt;b&gt;Interpolação&lt;/b&gt; H&lt;sub&gt;ij&lt;/sub&gt;(f) = Σ&lt;sub&gt;m&lt;/sub&gt; Λ&lt;sub&gt;m&lt;/sub&gt;(f) c&lt;sub&gt;ij,m&lt;/sub&gt;&lt;br&gt;Λ&lt;sub&gt;m&lt;/sub&gt;: chapéus lineares, Σ&lt;sub&gt;m&lt;/sub&gt; Λ&lt;sub&gt;m&lt;/sub&gt;(f) = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1345" y="505" width="310" height="70" as="geometry"/></mxCell><mxCell id="b_eq" value="h&lt;sub&gt;ij&lt;/sub&gt;(τ) = iRFFT(H&lt;sub&gt;ij&lt;/sub&gt;)(τ): o kernel lido da aresta; o zero-padding torna a convolução linear, não circular" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="585" width="640" height="45" as="geometry"/></mxCell><mxCell id="b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="b_sj" target="b_fft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="b_fft" target="b_mul"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="b_mul" target="b_sum"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="b_sum" target="b_ifft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="b_bands" target="b_interp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b6" value="H&lt;sub&gt;ij&lt;/sub&gt;(f)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=0.05;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_interp" target="b_mul"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pC" value="&lt;b&gt;C · Simulação recursiva de 1 passo (como se simula um ARX)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="680" height="210" as="geometry"/></mxCell><mxCell id="c_seq" value="sequência no passo k:&lt;br&gt;[ passado 168 h | ŷ(t+1..t+k−1) | 0 … ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="705" width="250" height="62" as="geometry"/></mxCell><mxCell id="c_step" value="filtro de 1 passo&lt;br&gt;na posição W+k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="705" width="170" height="62" as="geometry"/></mxCell><mxCell id="c_out" value="ŷ(t+k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="705" width="160" height="62" as="geometry"/></mxCell><mxCell id="c_note" value="• auto-arestas H&lt;sub&gt;ii&lt;/sub&gt;: parte autorregressiva (polos); arestas das entradas: parte exógena&lt;br&gt;• entradas conhecidas entram passo a passo; saídas futuras recebem a própria previsão&lt;br&gt;• um filtro aplicado de uma vez dá R² negativo em 12 h; iterado, 0,79" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="780" width="640" height="80" as="geometry"/></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="c_seq" target="c_step"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="c_step" target="c_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="k ← k+1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_out" target="c_seq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="690"/><mxPoint x="1145" y="690"/></Array></mxGeometry></mxCell><mxCell id="pD" value="&lt;b&gt;D · Resíduo não linear (por saída)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="890" width="680" height="170" as="geometry"/></mxCell><mxCell id="d_in" value="passado centrado&lt;br&gt;de y&lt;sub&gt;i&lt;/sub&gt; (168)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="935" width="150" height="60" as="geometry"/></mxCell><mxCell id="d_l1" value="Linear&lt;br&gt;168 → 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="935" width="120" height="60" as="geometry"/></mxCell><mxCell id="d_th" value="tanh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1340" y="935" width="80" height="60" as="geometry"/></mxCell><mxCell id="d_l2" value="Linear&lt;br&gt;16 → 12&lt;br&gt;(início = 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1445" y="935" width="120" height="60" as="geometry"/></mxCell><mxCell id="d_out" value="r&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590" y="935" width="70" height="60" as="geometry"/></mxCell><mxCell id="d_note" value="mesma MLP para as 3 saídas; não vê as outras séries: o acoplamento fica no grafo, onde há equação · 2.908 parâmetros" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="1005" width="640" height="45" as="geometry"/></mxCell><mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="d_in" target="d_l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="d_l1" target="d_th"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="d_th" target="d_l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="d_l2" target="d_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pE" value="&lt;b&gt;E · Cascata física do nível e combinação&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="1080" width="680" height="220" as="geometry"/></mxCell><mxCell id="e_casc" value="&lt;b&gt;Balanço de massa&lt;/b&gt; (integrador)&lt;br&gt;N(t+k) = N(t+k−1) + a·½(q̂&lt;sub&gt;k&lt;/sub&gt; + q̂&lt;sub&gt;k−1&lt;/sub&gt;) + b&lt;br&gt;q̂ = u₄ − ŷ₁, a = 0,00277 m/(l/s)&lt;br&gt;parte do nível medido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="1120" width="310" height="110" as="geometry"/></mxCell><mxCell id="e_blend" value="&lt;b&gt;Combinação por passo&lt;/b&gt;&lt;br&gt;ŷ₂(t+h) = w&lt;sub&gt;h&lt;/sub&gt;·N(t+h) + (1−w&lt;sub&gt;h&lt;/sub&gt;)·ŷ₂&lt;sup&gt;direto&lt;/sup&gt;&lt;br&gt;12 pesos por mínimos quadrados na validação&lt;br&gt;full: 0,93 → 0,70 · pumps: 0,87 → 0,14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="1120" width="310" height="110" as="geometry"/></mxCell><mxCell id="e_note" value="&lt;i&gt;perto da origem a cascata integrou pouco erro e domina; com o horizonte, o erro da vazão se acumula e a saída direta ganha peso&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="1240" width="640" height="50" as="geometry"/></mxCell><mxCell id="e_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="e_casc" target="e_blend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pF" value="&lt;b&gt;F · Função de perda (treino)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="1320" width="680" height="150" as="geometry"/></mxCell><mxCell id="f_eq" value="ℒ = Σ&lt;sub&gt;i&lt;/sub&gt; [ MSE&lt;sub&gt;i&lt;/sub&gt; / 2σ&lt;sub&gt;i&lt;/sub&gt;² + log σ&lt;sub&gt;i&lt;/sub&gt; ] + λ&lt;sub&gt;c&lt;/sub&gt;·MSE(nível&lt;sup&gt;cascata&lt;/sup&gt;) + ρ·[ α Σ |c&lt;sub&gt;ij,m&lt;/sub&gt;| + (1−α) Σ ‖c&lt;sub&gt;ij,·&lt;/sub&gt;‖ ]&lt;br&gt;&lt;br&gt;pesos por saída aprendidos (3 parâmetros) · cascata na perda: o erro do nível chega à vazão · lasso por grupo: zera bandas e arestas inteiras (ρ = 10⁻³)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="1355" width="640" height="105" as="geometry"/></mxCell><mxCell id="z1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="filt" target="pB"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="975"/><mxPoint x="950" y="510"/></Array></mxGeometry></mxCell><mxCell id="z0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="filt" target="pA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="960"/><mxPoint x="940" y="210"/></Array></mxGeometry></mxCell><mxCell id="z2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;exitX=1;exitY=0.05;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="loop" target="pC"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="z3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="resid" target="pD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="z4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;dashed=1;strokeColor=#999999;endArrow=open;endFill=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="casc" target="pE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="395"/><mxPoint x="965" y="1190"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>